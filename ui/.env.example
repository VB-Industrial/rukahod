# По умолчанию WS использует адрес машины, с которой открыта страница,
# а камеры — штатные WHEP адреса. Эти значения можно переопределить здесь
# или изменить в панели «Настройка» (сохраняется в браузере оператора).
# VITE_ARM_WS_URL=ws://<rover-ip>:8765
# VITE_ROVER_WS_URL=ws://<rover-ip>:8766
# VITE_CAMERA_FRONT_WHEP_URL=http://<camera-host>:8889/stream3/whep
# VITE_CAMERA_ARM_WHEP_URL=http://<camera-host>:8889/stream4/whep
