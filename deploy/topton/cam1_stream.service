[Unit]
Description=RukaHod first USB camera H264 stream cam1
After=mediamtx.service network-online.target
Wants=mediamtx.service network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=rosuser
Group=rosuser
SupplementaryGroups=video
ExecStart=/bin/bash /home/rosuser/rukahod/deploy/topton/cameras/cam1.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
